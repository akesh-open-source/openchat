# Copy to app/gateway/.env and adjust. Never commit app/gateway/.env.
#
# Gateway service (GATEWAY_ prefix)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_AUTH_SERVICE_URL=http://auth:8001
GATEWAY_USERS_SERVICE_URL=http://users:8002

# JWT verify only (RS256 public key). Never mount the private key here.
# Must be the public half of the key pair used by auth.
# Docker Compose mounts secrets/jwt/public.pem into /run/secrets/
GATEWAY_JWT_ALGORITHM=RS256
GATEWAY_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# Edge rate limits for /auth/* (per client IP)
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_AUTH_STRICT_PER_WINDOW=20
GATEWAY_RATE_LIMIT_AUTH_DEFAULT_PER_WINDOW=60
