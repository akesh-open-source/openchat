# Copy to app/messaging/.env and adjust. Never commit app/messaging/.env.
#
# Postgres image vars (used by postgres-messaging container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openchat_messaging

# Messaging service (MESSAGING_ prefix)
MESSAGING_HOST=0.0.0.0
MESSAGING_PORT=8003
MESSAGING_DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres-messaging:5432/openchat_messaging

# JWT verify only (RS256 public key). Never mount the private key here.
# Must be the public half of the key pair used by auth.
# Docker Compose mounts secrets/jwt/public.pem into /run/secrets/
MESSAGING_JWT_ALGORITHM=RS256
MESSAGING_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
