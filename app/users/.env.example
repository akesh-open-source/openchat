# Copy to app/users/.env and adjust. Never commit app/users/.env.
#
# Postgres image vars (used by postgres-users container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openchat_users

# Users service (USERS_ prefix)
USERS_HOST=0.0.0.0
USERS_PORT=8002
USERS_DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres-users:5432/openchat_users
