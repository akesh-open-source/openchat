# Copy to app/auth/.env and adjust. Never commit app/auth/.env.
#
# Postgres image vars (used by postgres-auth container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openchat_auth

# Auth service (AUTH_ prefix)
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres-auth:5432/openchat_auth
