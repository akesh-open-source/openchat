# Copy to app/auth/.env and adjust. Never commit app/auth/.env.
#
# Postgres image vars (used by postgres-auth container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openchat_auth

# Auth service (AUTH_ prefix)
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres-auth:5432/openchat_auth

# JWT
AUTH_JWT_SECRET=change-me-use-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_REGISTRATION_TOKEN_EXPIRE_MINUTES=60

# Redis (pending registration tokens)
AUTH_REDIS_URL=redis://auth-redis:6379/0

# SMTP (Mailpit in docker-compose: UI http://localhost:8025)
AUTH_SMTP_HOST=mailpit
AUTH_SMTP_PORT=1025
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_USE_TLS=false
AUTH_SMTP_USE_SSL=false
AUTH_SMTP_FROM_EMAIL=noreply@openchat.local
AUTH_SMTP_FROM_NAME=OpenChat
AUTH_PASSWORD_RESET_URL_BASE=http://localhost:8000/docs
AUTH_REGISTRATION_VERIFY_URL_BASE=http://localhost:8000/docs
AUTH_LOGIN_URL=http://localhost:8000/docs
